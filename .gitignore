# Python bytecode
__pycache__/
*.py[cod]
*.pyo

# Virtual environments
.venv/
venv/
env/
# ...including one created in-place at the repo root
Lib/
Scripts/
pyvenv.cfg

# Database (generated at runtime)
mashup.db
mashup.db-wal
mashup.db-shm

# Downloaded audio (large binary files)
audio/

# Docker volume mount (downloaded songs, stems, DB, Demucs weights)
data/

# Frontend (Vite + React)
frontend/node_modules/
frontend/dist/

# OS / editor
.DS_Store
*.swp
*.swo

# IDE
.idea/

# Test cache
.pytest_cache/

# UVR MDX-Net weights (downloaded on first "Fast" separation, ~50-300MB each)
uvr_models/

# Tool scratch output
graphify-out/
.playwright-mcp/

# Secrets: API keys and credentials live in .env (read by docker compose) or in
# the settings.json outside the repo — never in committed files. .env.example is
# the committed template with every key name and no values.
.env
.env.*
*.env
!.env.example
*.pem
*.key

# Runtime artifact folders when data_dir is the repo root
/models/
/datasets/
/snapshots/

# Personal Claude Code permissions
.claude/settings.local.json
