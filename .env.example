# Copy to .env and fill in what you use. .env is gitignored — never commit keys.
# docker compose reads .env automatically. Without Docker, export these in your
# shell, or paste the keys into the app (they are then saved to settings.json in
# your user settings folder, outside the repo).

# 1001tracklists imports on the Mixes tab (https://firecrawl.dev)
FIRECRAWL_API_KEY=

# SoundCloud registered app — only needed for the dormant crate push / likes.
# Registration requires a SoundCloud Artist Pro subscription.
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=

# Optional tuning
MASHUP_PIPELINE_WORKERS=1
